<ui:FluentWindow x:Class="Tasks.App.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:Tasks.App.Converters"
        xmlns:vm="clr-namespace:Tasks.App.ViewModels"
        mc:Ignorable="d"
        Title="Tasks - Login e Cadastro"
        Height="670" MinHeight="580" MaxHeight="780" Width="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="28,12,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="Auto"/> <!-- Brand / Logo -->
            <RowDefinition Height="Auto"/> <!-- Mensagens de Erro / Sucesso -->
            <RowDefinition Height="*"/>    <!-- Formulários com ScrollViewer -->
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Tasks - Autenticação" ShowMaximize="False" ShowMinimize="True" Margin="-28,-12,-28,10"/>

        <!-- Brand Header -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,12">
            <Border Width="48" Height="48" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,8" ClipToBounds="True">
                <Image Source="pack://application:,,,/Resources/app_icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock Text="Tasks Desktop" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Organize seu dia a dia e alcance seus objetivos" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Mensagens de Alerta -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <!-- Mensagem de Erro -->
            <Border Background="#25EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,4" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- Mensagem de Sucesso -->
            <Border Background="#2510B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="10,8" Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#10B981" FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- ================= PAINÉIS DE FORMULÁRIO COM SCROLL AUTO ================= -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,4">
            <Grid>
                <!-- PAINEL DE LOGIN -->
                <StackPanel Visibility="{Binding IsLoginState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Entrar na sua conta" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <TextBlock Text="E-mail" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ui:TextBox Text="{Binding LoginEmail, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="seu@email.com" Margin="0,0,0,12" FontSize="13"/>

                    <TextBlock Text="Senha" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ui:PasswordBox x:Name="LoginPasswordBox" PasswordChanged="LoginPasswordBox_PasswordChanged" PlaceholderText="Sua senha" Margin="0,0,0,12" FontSize="13"/>

                    <CheckBox Content="Lembrar de mim neste computador" IsChecked="{Binding RememberMe}" Margin="0,0,0,16"/>

                    <ui:Button Content="Entrar" 
                               Appearance="Primary" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Stretch" 
                               Padding="0,10"
                               Margin="0,0,0,16"
                               Command="{Binding LoginCommand}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="Ainda não tem conta? " FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:HyperlinkButton Content="Cadastre-se" Padding="0" Command="{Binding SwitchToRegisterCommand}"/>
                    </StackPanel>
                </StackPanel>

                <!-- PAINEL DE CADASTRO -->
                <StackPanel Visibility="{Binding IsRegisterState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Criar nova conta" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <TextBlock Text="Seu Nome Completo" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ui:TextBox Text="{Binding RegisterName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ex: João Silva" Margin="0,0,0,10" FontSize="13"/>

                    <TextBlock Text="E-mail" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ui:TextBox Text="{Binding RegisterEmail, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="seu@email.com" Margin="0,0,0,10" FontSize="13"/>

                    <TextBlock Text="Senha (mínimo 6 caracteres)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ui:PasswordBox x:Name="RegisterPasswordBox" PasswordChanged="RegisterPasswordBox_PasswordChanged" PlaceholderText="Crie uma senha" Margin="0,0,0,10" FontSize="13"/>

                    <TextBlock Text="Confirmar Senha" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ui:PasswordBox x:Name="RegisterConfirmPasswordBox" PasswordChanged="RegisterConfirmPasswordBox_PasswordChanged" PlaceholderText="Repita a senha" Margin="0,0,0,14" FontSize="13"/>

                    <ui:Button Content="Criar Conta e Receber Código" 
                               Appearance="Primary" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Stretch" 
                               Padding="0,10"
                               Margin="0,0,0,14"
                               Command="{Binding RegisterCommand}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="Já possui uma conta? " FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:HyperlinkButton Content="Fazer login" Padding="0" Command="{Binding SwitchToLoginCommand}"/>
                    </StackPanel>
                </StackPanel>

                <!-- PAINEL DE VERIFICAÇÃO DE CÓDIGO -->
                <StackPanel Visibility="{Binding IsVerificationState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Verificação de E-mail" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Enviamos um código de 6 dígitos para o e-mail:" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding VerificationEmail}" FontSize="13" FontWeight="Bold" Foreground="#6366F1" Margin="0,2,0,14"/>

                    <TextBlock Text="Código de 6 dígitos" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ui:TextBox Text="{Binding VerificationCode, UpdateSourceTrigger=PropertyChanged}" 
                                PlaceholderText="000000" 
                                FontSize="22" 
                                FontWeight="Bold" 
                                HorizontalContentAlignment="Center" 
                                Margin="0,0,0,14"
                                MaxLength="6"/>

                    <ui:Button Content="Confirmar e Acessar" 
                               Appearance="Primary" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Stretch" 
                               Padding="0,10"
                               Margin="0,0,0,10"
                               Command="{Binding VerifyCodeCommand}"/>

                    <ui:Button Content="Reenviar Código para o E-mail" 
                               Appearance="Secondary" 
                               HorizontalAlignment="Stretch" 
                               Padding="0,8"
                               Margin="0,0,0,14"
                               Command="{Binding ResendCodeCommand}"/>

                    <ui:HyperlinkButton Content="← Voltar para a tela de Login" HorizontalAlignment="Center" Command="{Binding SwitchToLoginCommand}" Margin="0,0,0,10"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
