<UserControl x:Class="Tasks.App.Views.DailyTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Tasks.App.Converters"
             xmlns:vm="clr-namespace:Tasks.App.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:PriorityToColorConverter x:Key="PriorityToColorConverter"/>
        <conv:PriorityToBackgroundConverter x:Key="PriorityToBackgroundConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" MinWidth="340" MaxWidth="440"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= COLUNA ESQUERDA: CALENDÁRIO ================= -->
        <Border Grid.Column="0" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="14" 
                Margin="0,0,16,0" 
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header do Mês -->
                    <RowDefinition Height="Auto"/> <!-- Dias da semana -->
                    <RowDefinition Height="*"/>    <!-- Grade de dias -->
                    <RowDefinition Height="Auto"/> <!-- Atalhos / Hoje -->
                </Grid.RowDefinitions>

                <!-- Header do Mês e Navegação -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentMonthHeader}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon ChevronLeft24}" Appearance="Secondary" Padding="8,6" Margin="0,0,6,0" Command="{Binding PreviousMonthCommand}" ToolTip="Mês Anterior"/>
                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon ChevronRight24}" Appearance="Secondary" Padding="8,6" Command="{Binding NextMonthCommand}" ToolTip="Próximo Mês"/>
                </Grid>

                <!-- Cabeçalho dos Dias da Semana -->
                <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,8">
                    <TextBlock Text="DOM" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="SEG" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="TER" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="QUA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="QUI" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="SEX" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="SÁB" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </UniformGrid>

                <!-- Grade do Calendário -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding CalendarDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="2" 
                                    Padding="0" 
                                    Height="48" 
                                    Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    CommandParameter="{Binding}"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="#6366F1"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="DayBorder" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <!-- Dia Selecionado -->
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="#6366F1"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                            <!-- Dia de Hoje (quando não selecionado) -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsToday}" Value="True"/>
                                                    <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                <Setter Property="BorderBrush" Value="#6366F1"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Número do Dia -->
                                    <TextBlock Grid.Row="0" 
                                               Text="{Binding DayNumber}" 
                                               FontSize="13" 
                                               FontWeight="SemiBold" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Indicador de Tarefas do Dia (Badge / Bolinha) -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3" Visibility="{Binding HasTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Width="6" Height="6" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <!-- Se concluiu tudo: Verde -->
                                                    <Setter Property="Background" Value="#10B981"/>
                                                    <Style.Triggers>
                                                        <!-- Se tem pendentes: Âmbar/Laranja -->
                                                        <DataTrigger Binding="{Binding IsAllCompleted}" Value="False">
                                                            <Setter Property="Background" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                        <!-- Se selecionado: Branco -->
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Botão de Atalho "Ir para Hoje" -->
                <ui:Button Grid.Row="3" 
                           Content="Voltar para Hoje" 
                           Icon="{ui:SymbolIcon CalendarToday24}" 
                           Appearance="Secondary" 
                           HorizontalAlignment="Stretch" 
                           Margin="0,12,0,0" 
                           Command="{Binding GoToTodayCommand}"/>
            </Grid>
        </Border>

        <!-- ================= COLUNA DIREITA: TAREFAS DO DIA SELECIONADO ================= -->
        <Border Grid.Column="1" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="14" 
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header do Dia Selecionado -->
                    <RowDefinition Height="Auto"/> <!-- Barra de Progresso do Dia -->
                    <RowDefinition Height="*"/>    <!-- Lista de Tarefas -->
                </Grid.RowDefinitions>

                <!-- Header do Dia Selecionado -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding FormattedSelectedDate}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding DayProgressSummary}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Badge se a data for no passado -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" 
                                CornerRadius="8" 
                                Padding="10,6" 
                                Visibility="{Binding IsPastDate, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="History24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Histórico (Data Passada)" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Botão Nova Tarefa (somente para hoje ou datas futuras) -->
                        <ui:Button Content="Nova Tarefa" 
                                   Icon="{ui:SymbolIcon Add24}" 
                                   Appearance="Primary" 
                                   FontWeight="SemiBold"
                                   Padding="16,8"
                                   Visibility="{Binding CanAddTaskToSelectedDate, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Command="{Binding AddNewDailyTaskCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Barra de Progresso do Dia -->
                <ProgressBar Grid.Row="1" 
                             Height="6" 
                             Value="{Binding DayProgressPercentage, Mode=OneWay}" 
                             Foreground="#10B981" 
                             Background="{DynamicResource ControlFillColorDefaultBrush}" 
                             Margin="0,0,0,16"/>

                <!-- Lista de Tarefas do Dia -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <!-- Estado Vazio -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TotalTasksCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:SymbolIcon Symbol="CheckmarkCircle48" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Nenhuma tarefa para este dia" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Clique em 'Nova Tarefa' para agendar uma atividade" 
                                       FontSize="13" 
                                       HorizontalAlignment="Center" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                       Margin="0,4,0,12"
                                       Visibility="{Binding CanAddTaskToSelectedDate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ui:Button Content="Criar Tarefa para este Dia" 
                                       Appearance="Secondary" 
                                       HorizontalAlignment="Center" 
                                       Visibility="{Binding CanAddTaskToSelectedDate, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Command="{Binding AddNewDailyTaskCommand}"/>
                        </StackPanel>

                        <!-- Cards das Tarefas -->
                        <ItemsControl ItemsSource="{Binding TasksForSelectedDate}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="10" 
                                            Margin="0,0,0,10" 
                                            Padding="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Checkbox Conclusão -->
                                                <ColumnDefinition Width="*"/>    <!-- Informações da Tarefa -->
                                                <ColumnDefinition Width="Auto"/> <!-- Botão de Exclusão -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox de Conclusão Diária -->
                                            <CheckBox Grid.Column="0" 
                                                      IsChecked="{Binding IsCompleted}" 
                                                      VerticalAlignment="Top" 
                                                      Margin="0,2,14,0"/>

                                            <!-- Informações e Subtarefas -->
                                            <StackPanel Grid.Column="1">
                                                <!-- Badges Superiores -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <!-- Badge de Prioridade -->
                                                    <Border CornerRadius="6" Padding="6,2" Background="{Binding Priority, Converter={StaticResource PriorityToBackgroundConverter}}" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Priority}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Priority, Converter={StaticResource PriorityToColorConverter}}"/>
                                                    </Border>

                                                    <!-- Badge de Recorrência / Frequência -->
                                                    <Border CornerRadius="6" Padding="6,2" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="ArrowRepeatAll20" FontSize="11" Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding RecurrenceText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Título da Tarefa -->
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Descrição (se houver) -->
                                                <TextBlock Text="{Binding Description}" 
                                                           FontSize="13" 
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                           TextWrapping="Wrap" 
                                                           Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}"
                                                           Margin="0,0,0,8"/>

                                                <!-- Checklist / Subtarefas da Tarefa -->
                                                <ItemsControl ItemsSource="{Binding Checklists}" Margin="0,4,0,0" Visibility="{Binding HasChecklist, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Botão Excluir Tarefa -->
                                            <ui:Button Grid.Column="2" 
                                                       Icon="{ui:SymbolIcon Delete24}" 
                                                       Appearance="Transparent" 
                                                       VerticalAlignment="Top" 
                                                       Padding="6"
                                                       ToolTip="Excluir tarefa"
                                                       Command="{Binding DataContext.DeleteDailyTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
