<ui:FluentWindow x:Class="Tasks.App.Views.DailyTaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Tasks.App.ViewModels"
        mc:Ignorable="d"
        Title="Nova Tarefa Diária"
        Height="620" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid Margin="24,12,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="Auto"/> <!-- Título -->
            <RowDefinition Height="Auto"/> <!-- Recorrência / Frequência -->
            <RowDefinition Height="Auto"/> <!-- Data Início & Prioridade -->
            <RowDefinition Height="Auto"/> <!-- Descrição -->
            <RowDefinition Height="*"/>    <!-- Checklist -->
            <RowDefinition Height="Auto"/> <!-- Botões -->
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Criar Tarefa Diária" ShowMaximize="False" ShowMinimize="False" Margin="-24,-12,-24,12"/>

        <!-- Título -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Título da Tarefa *" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ui:TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ex: Fazer 30min de caminhada, Revisar e-mails..." FontSize="14"/>
        </StackPanel>

        <!-- Recorrência / Frequência -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Duração / Frequência da Tarefa *" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ComboBox ItemsSource="{Binding RecurrenceOptions}" 
                      SelectedItem="{Binding SelectedRecurrence}" 
                      DisplayMemberPath="DisplayName" 
                      HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- Data Início e Prioridade -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Data de Início" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <DatePicker x:Name="StartDatePicker" SelectedDate="{Binding StartDate}" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Prioridade" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Grid>

        <!-- Descrição -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="Descrição (opcional)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                        PlaceholderText="Notas ou instruções adicionais..." 
                        AcceptsReturn="True" 
                        Height="55" 
                        VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Checklist de Subtarefas -->
        <Grid Grid.Row="5" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Subtarefas / Checklist (opcional)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <!-- Adicionar novo item -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" Text="{Binding NewChecklistTitle, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Adicionar etapa ou subtarefa..."/>
                <ui:Button Grid.Column="2" Content="Adicionar" Appearance="Secondary" Command="{Binding AddChecklistDraftCommand}"/>
            </Grid>

            <!-- Lista de itens -->
            <ui:Card Grid.Row="2" Padding="8,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ChecklistDrafts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Checkmark16" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" FontSize="13"/>
                                    <ui:Button Grid.Column="2" 
                                               Icon="{ui:SymbolIcon Dismiss20}" 
                                               Appearance="Transparent" 
                                               Padding="4"
                                               Command="{Binding DataContext.RemoveChecklistDraftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </ui:Card>
        </Grid>

        <!-- Botões -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Cancelar" Appearance="Secondary" Click="Cancel_Click" Margin="0,0,8,0" Width="100"/>
            <ui:Button Content="Salvar Tarefa" Appearance="Primary" Click="Save_Click" Width="120"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
