<ui:FluentWindow x:Class="Tasks.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:dd="urn:gong-wpf-dragdrop"
        xmlns:tb="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tray="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:conv="clr-namespace:Tasks.App.Converters"
        xmlns:vm="clr-namespace:Tasks.App.ViewModels"
        mc:Ignorable="d"
        Title="Tasks - Meu Gerenciador de Tarefas"
        Height="760" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Window.Resources>
        <conv:PriorityToColorConverter x:Key="PriorityToColorConverter"/>
        <conv:PriorityToBackgroundConverter x:Key="PriorityToBackgroundConverter"/>
        <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="Auto"/> <!-- Header / Toolbar -->
            <RowDefinition Height="*"/>    <!-- Kanban Board -->
        </Grid.RowDefinitions>

        <!-- System Tray Icon -->
        <tray:TaskbarIcon x:Name="TrayIcon"
                          ToolTipText="Tasks - Kanban &amp; Checklist"
                          IconSource="pack://application:,,,/Resources/app_icon.ico"
                          DoubleClickCommand="{Binding ShowWindowCommand}">
            <tray:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Abrir Kanban" Command="{Binding ShowWindowCommand}"/>
                    <MenuItem Header="Nova Tarefa Rápida" Command="{Binding AddQuickTaskCommand}"/>
                    <Separator/>
                    <MenuItem Header="Alternar Tema Claro/Escuro" Command="{Binding ToggleThemeCommand}"/>
                    <Separator/>
                    <MenuItem Header="Sair" Command="{Binding ExitApplicationCommand}"/>
                </ContextMenu>
            </tray:TaskbarIcon.ContextMenu>
        </tray:TaskbarIcon>

        <!-- Windows 11 TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Tasks Desktop" ShowMaximize="True" ShowMinimize="True"/>

        <!-- Header / Toolbar -->
        <Border Grid.Row="1" Margin="24,8,24,16" Padding="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & Título -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Resources/app_icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Meu Quadro de Tarefas" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Arraste e solte para organizar suas atividades" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Ações do Topo -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Nova Tarefa" 
                               Icon="{ui:SymbolIcon Add24}" 
                               Appearance="Primary" 
                               FontWeight="SemiBold"
                               Padding="16,8"
                               Margin="0,0,10,0"
                               Command="{Binding KanbanVm.AddNewTaskCommand}"/>

                    <ui:Button Icon="{ui:SymbolIcon DarkTheme24}" 
                               Appearance="Secondary" 
                               ToolTip="Alternar Tema Claro / Escuro" 
                               Padding="10,8"
                               Command="{Binding ToggleThemeCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Kanban Board (Colunas Horizontais com Scroll) -->
        <ScrollViewer Grid.Row="2" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Disabled" 
                      Margin="24,0,24,20"
                      Padding="0,0,0,8">
            <ItemsControl ItemsSource="{Binding KanbanVm.Columns}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Card da Coluna -->
                        <Border Width="310" 
                                Margin="0,0,16,0" 
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Header da Coluna -->
                                    <RowDefinition Height="*"/>    <!-- Lista de Cards -->
                                    <RowDefinition Height="Auto"/> <!-- Rodapé da Coluna / Quick Add -->
                                </Grid.RowDefinitions>

                                <!-- Header da Coluna -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Pill colorido -->
                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                    <!-- Nome da Coluna -->
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                    <!-- Contador de Tarefas -->
                                    <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TaskCount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Border>

                                    <!-- Botão de Adicionar na Coluna -->
                                    <ui:Button Grid.Column="3" 
                                               Icon="{ui:SymbolIcon Add16}" 
                                               Appearance="Transparent" 
                                               Padding="4" 
                                               ToolTip="Adicionar tarefa nesta coluna"
                                               Command="{Binding DataContext.KanbanVm.AddNewTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}"/>
                                </Grid>

                                <!-- Lista de Tarefas com Drag and Drop -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ListBox ItemsSource="{Binding Tasks}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             dd:DragDrop.IsDragSource="True"
                                             dd:DragDrop.IsDropTarget="True"
                                             dd:DragDrop.DropHandler="{Binding DataContext.KanbanVm, RelativeSource={RelativeSource AncestorType=Window}}"
                                             MouseDoubleClick="TaskCard_MouseDoubleClick">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,10"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Card Individual da Tarefa -->
                                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="10" 
                                                        Padding="12"
                                                        Cursor="Hand">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Editar Tarefa" 
                                                                      Command="{Binding DataContext.KanbanVm.EditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="Excluir Tarefa" 
                                                                      Command="{Binding DataContext.KanbanVm.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/> <!-- Badges / Prioridade -->
                                                            <RowDefinition Height="Auto"/> <!-- Título -->
                                                            <RowDefinition Height="Auto"/> <!-- Descrição -->
                                                            <RowDefinition Height="Auto"/> <!-- Checklist & Data -->
                                                        </Grid.RowDefinitions>

                                                        <!-- Badges: Prioridade e Data -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Badge de Prioridade -->
                                                            <Border Grid.Column="0" 
                                                                    CornerRadius="6" 
                                                                    Padding="6,2" 
                                                                    Background="{Binding Priority, Converter={StaticResource PriorityToBackgroundConverter}}">
                                                                <TextBlock Text="{Binding Priority}" 
                                                                           FontSize="11" 
                                                                           FontWeight="SemiBold" 
                                                                           Foreground="{Binding Priority, Converter={StaticResource PriorityToColorConverter}}"/>
                                                            </Border>

                                                            <!-- Data de Vencimento -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding DueDate, Converter={StaticResource NullToVisibilityConverter}}">
                                                                <ui:SymbolIcon Symbol="CalendarLtr16" FontSize="12" Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding DueDate, StringFormat={}{0:dd/MM}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Título do Card -->
                                                        <TextBlock Grid.Row="1" 
                                                                   Text="{Binding Title}" 
                                                                   FontSize="14" 
                                                                   FontWeight="SemiBold" 
                                                                   TextWrapping="Wrap" 
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                                   Margin="0,0,0,6"/>

                                                        <!-- Descrição (se houver) -->
                                                        <TextBlock Grid.Row="2" 
                                                                   Text="{Binding Description}" 
                                                                   FontSize="12" 
                                                                   MaxHeight="36" 
                                                                   TextTrimming="CharacterEllipsis" 
                                                                   TextWrapping="Wrap" 
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                                   Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}"
                                                                   Margin="0,0,0,8"/>

                                                        <!-- Checklist & Progresso -->
                                                        <Grid Grid.Row="3" Margin="0,4,0,0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Texto Checklist -->
                                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4" Visibility="{Binding HasChecklist, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <ui:SymbolIcon Symbol="CheckmarkCircle16" FontSize="12" Margin="0,0,4,0" Foreground="#10B981"/>
                                                                <TextBlock Text="Checklist " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding ChecklistProgressText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            </StackPanel>

                                                            <!-- Barra de Progresso do Checklist -->
                                                            <ProgressBar Grid.Row="1" 
                                                                         Height="4" 
                                                                         Value="{Binding ProgressPercentage, Mode=OneWay}" 
                                                                         Foreground="#10B981" 
                                                                         Background="{DynamicResource ControlFillColorDefaultBrush}" 
                                                                         Visibility="{Binding HasChecklist, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>

                                <!-- Botão de adicionar no rodapé -->
                                <ui:Button Grid.Row="2" 
                                           Content="+ Adicionar cartão" 
                                           Appearance="Transparent" 
                                           HorizontalAlignment="Stretch" 
                                           HorizontalContentAlignment="Left"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Command="{Binding DataContext.KanbanVm.AddNewTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
