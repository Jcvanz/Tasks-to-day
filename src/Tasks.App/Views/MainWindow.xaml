<ui:FluentWindow x:Class="Tasks.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tray="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:conv="clr-namespace:Tasks.App.Converters"
        xmlns:views="clr-namespace:Tasks.App.Views"
        xmlns:vm="clr-namespace:Tasks.App.ViewModels"
        mc:Ignorable="d"
        Title="Tasks - Meu Gerenciador de Tarefas"
        Height="780" Width="1240"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="*"/>    <!-- Main Layout (Sidebar + Content) -->
        </Grid.RowDefinitions>

        <!-- System Tray Icon -->
        <tray:TaskbarIcon x:Name="TrayIcon"
                          ToolTipText="Tasks - Meu Dia a Dia &amp; Objetivos"
                          IconSource="pack://application:,,,/Resources/app_icon.ico"
                          DoubleClickCommand="{Binding ShowWindowCommand}">
            <tray:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Abrir Tasks" Command="{Binding ShowWindowCommand}"/>
                    <MenuItem Header="Nova Tarefa Rápida" Command="{Binding AddQuickTaskCommand}"/>
                    <Separator/>
                    <MenuItem Header="Alternar Tema Claro/Escuro" Command="{Binding ToggleThemeCommand}"/>
                    <Separator/>
                    <MenuItem Header="Sair" Command="{Binding ExitApplicationCommand}"/>
                </ContextMenu>
            </tray:TaskbarIcon.ContextMenu>
        </tray:TaskbarIcon>

        <!-- Windows 11 Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Tasks Desktop" ShowMaximize="True" ShowMinimize="True"/>

        <!-- Main Layout: Sidebar Esquerda + Conteúdo Principal -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= SIDEBAR DE NAVEGAÇÃO ================= -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="14" 
                    Padding="14" 
                    Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- App Brand / Logo -->
                        <RowDefinition Height="*"/>    <!-- Navigation Items -->
                        <RowDefinition Height="Auto"/> <!-- Theme Toggle / Footer -->
                    </Grid.RowDefinitions>

                    <!-- Brand / Logo -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,8,6,24">
                        <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0" ClipToBounds="True">
                            <Image Source="pack://application:,,,/Resources/app_icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tasks" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Planejador Diário" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Botões de Navegação Lateral -->
                    <StackPanel Grid.Row="1">
                        <!-- Meu Dia a Dia (Calendário) -->
                        <RadioButton GroupName="AppNav" 
                                     IsChecked="True" 
                                     Click="NavDailyTasks_Click"
                                     Margin="0,0,0,8"
                                     Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="ItemBorder" CornerRadius="10" Padding="12,10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="18" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Meu Dia a Dia" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#6366F1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Quadro de Objetivos (Kanban) -->
                        <RadioButton GroupName="AppNav" 
                                     Click="NavGoals_Click"
                                     Margin="0,0,0,8"
                                     Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="ItemBorder" CornerRadius="10" Padding="12,10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Target24" FontSize="18" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Quadro de Objetivos" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#3B82F6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </StackPanel>

                    <!-- Rodapé da Sidebar: Perfil + Tema + Logout -->
                    <StackPanel Grid.Row="2">
                        <!-- Perfil do Usuário Logado -->
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#6366F1" Margin="0,0,8,0">
                                    <ui:SymbolIcon Symbol="Person24" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentUserName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding CurrentUserEmail}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ui:Button Icon="{ui:SymbolIcon DarkTheme24}" 
                                   Content="Alternar Tema" 
                                   Appearance="Secondary" 
                                   HorizontalAlignment="Stretch" 
                                   HorizontalContentAlignment="Left" 
                                   Padding="12,8" 
                                   Margin="0,0,0,6"
                                   Command="{Binding ToggleThemeCommand}"/>

                        <ui:Button Icon="{ui:SymbolIcon SignOut24}" 
                                   Content="Sair da Conta" 
                                   Appearance="Transparent" 
                                   Foreground="#EF4444"
                                   HorizontalAlignment="Stretch" 
                                   HorizontalContentAlignment="Left" 
                                   Padding="12,8" 
                                   Command="{Binding LogoutCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= ÁREA DE CONTEÚDO PRINCIPAL ================= -->
            <Grid Grid.Column="1">
                <!-- Meu Dia a Dia (Calendário & Tarefas Diárias) -->
                <views:DailyTasksView x:Name="DailyTasksViewControl" 
                                      DataContext="{Binding DailyTasksVm}" 
                                      Visibility="Visible"/>

                <!-- Quadro de Objetivos (Kanban com Drag & Drop) -->
                <views:GoalsKanbanView x:Name="GoalsKanbanViewControl" 
                                       DataContext="{Binding KanbanVm}" 
                                       Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
